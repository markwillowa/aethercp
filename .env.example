APP_NAME=AetherCP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# AetherCP Web Application Database (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aether_cp
DB_USERNAME=aether_user
DB_PASSWORD=your_secure_password
# Optional Unix socket for Linux (e.g. /var/run/mysqld/mysqld.sock)
DB_SOCKET=

# Ragnarok Game Server Database Connection
RO_DB_HOST=127.0.0.1
RO_DB_PORT=3306
RO_DB_DATABASE=ragnarok
RO_DB_USERNAME=ragnarok_user
RO_DB_PASSWORD=your_game_db_password
RO_DB_CHARSET=utf8mb4
RO_DB_COLLATION=utf8mb4_unicode_ci
# Optional Unix socket for Linux game db
RO_DB_SOCKET=

# Ragnarok Server Settings
RO_SERVER_NAME="My Ragnarok Online"
RO_EMULATOR=rathena
RO_RENEWAL=true
RO_PASSWORD_HASH=md5
RO_LOGIN_IP=127.0.0.1
RO_LOGIN_PORT=6900
RO_CHAR_IP=127.0.0.1
RO_CHAR_PORT=6121
RO_MAP_IP=127.0.0.1
RO_MAP_PORT=5121

# Web Theme
AETHER_THEME=aether-dark

# Session & Cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
