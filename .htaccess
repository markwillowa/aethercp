<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Prevent direct access to sensitive configuration and environment files
    RewriteRule ^(\.env|\.git|\.editorconfig|composer\.|package\.|phpunit\.) - [F,L]

    # Block direct access to physical PHP/JSON/SQL files in backend directories
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/ - [F,L]

    # Rewrite all requests to public/
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
